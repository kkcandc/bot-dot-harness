# Optional. With neither key set, Harness stays in mock mode and still runs the full cockpit.
# Mock is the default even when a key exists. Live is an explicit toggle in the UI.

# Direct Claude. Used first when both keys are present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter can front Claude or a ChatGPT-family model. Change the model, not the code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_MODEL=openai/gpt-4.1
